{
  "name": "@aster/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "aster-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "aster-source": "./src/testing/context.ts",
      "types": "./dist/testing/context.d.ts",
      "default": "./dist/testing/context.js"
    },
    "./contracts": {
      "aster-source": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@aster/actor": "workspace:*",
    "@aster/agent": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0"
  }
}
