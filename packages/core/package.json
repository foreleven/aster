{
  "name": "@aster/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "aster-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "aster-source": "./src/testing/context.ts",
      "types": "./dist/testing/context.d.ts",
      "default": "./dist/testing/context.js"
    },
    "./contracts": {
      "aster-source": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./agent": {
      "aster-source": "./src/agent/index.ts",
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/session": {
      "aster-source": "./src/agent/runtime/session.ts",
      "types": "./dist/agent/runtime/session.d.ts",
      "default": "./dist/agent/runtime/session.js"
    },
    "./agent/ordinary": {
      "aster-source": "./src/agent/runtime/ordinary-runtime.ts",
      "types": "./dist/agent/runtime/ordinary-runtime.d.ts",
      "default": "./dist/agent/runtime/ordinary-runtime.js"
    }
  },
  "scripts": {
    "build": "node scripts/instructions.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/instructions.mjs && tsc --noEmit",
    "test": "node scripts/instructions.mjs && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@aster/actor": "workspace:*",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "effect": "4.0.0"
  }
}
