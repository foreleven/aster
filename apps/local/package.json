{
  "name": "@aster/local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "aster": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "start": "node --use-env-proxy --conditions=aster-source --import=tsx src/cli.ts start",
    "start:built": "node --use-env-proxy dist/cli.js start"
  },
  "dependencies": {
    "@aster/actor": "workspace:*",
    "@aster/core": "workspace:*",
    "@aster/integrations": "workspace:*",
    "effect": "4.0.0",
    "@aster/api": "workspace:*",
    "@effect/platform-node": "4.0.0",
    "@aster/infra": "workspace:*",
    "@aster/agent": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
